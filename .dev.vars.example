# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Bootstrap administrator Access login emails (comma-separated).
# In production, set this with: wrangler secret put ADMIN_EMAILS
ADMIN_EMAILS=admin@localhost.test


# New installs/local setup only: generate a random value of at least 32 characters.
BOOTSTRAP_TOKEN=

# Local development only: 32+ random characters to encrypt domain provider credentials.
# Production deployment creates this Secret automatically if absent and preserves it thereafter.
DOMAIN_CONFIG_KEY=
